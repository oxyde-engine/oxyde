// The character's own measurements, from its CNS constants sections.
constants {
    data {
        life = 1000
        power = 3000
        attack = 100
        defence = 100
        fall.defence_up = 50
        liedown.time = 60
        airjuggle = 15
        sparkno = 2
        guard.sparkno = 40
        ko.echo = 0
        volume = 0
        intpersistindex = 60
        floatpersistindex = 40
    }
    size {
        xscale = 0.187
        yscale = 0.187
        ground.back = 14
        ground.front = 16
        air.back = 12
        air.front = 12
        height = 60
        attack.dist = 160
        proj.attack.dist = 90
        proj.doscale = 0
        head.pos = -5, -86
        mid.pos = -5, -45
        shadowoffset = 0
        draw.offset = 0,0
    }
    velocity {
        walk.fwd = 2.6
        walk.back = -2.4
        run.fwd = 6.0, 0
        run.back = -4.6,-3.8
        jump.neu = 0,-8.6
        jump.back = -2.6
        jump.fwd = 2.8
        runjump.back = -2.6,-8.2
        runjump.fwd = 4.2,-8.2
        airjump.neu = 0,-8.2
        airjump.back = -2.6
        airjump.fwd = 2.8
        air.gethit.groundrecover = -0.15,-3.5
        air.gethit.airrecover.mul = 0.5
        air.gethit.airrecover.add = 0,-3.5
        air.gethit.airrecover.back = -1
        air.gethit.airrecover.fwd = 0
        air.gethit.airrecover.up = -2
        air.gethit.airrecover.down = 1.5
    }
    movement {
        airjump.num = 1
        airjump.height = 35
        yaccel = 0.44
        stand.friction = 0.85
        crouch.friction = 0.82
        stand.friction.threshold = 2
        crouch.friction.threshold = 0.05
        air.friction.threshold = 0.5
        air.gethit.groundlevel = 25
        air.gethit.groundrecover.ground.threshold = -20
        air.gethit.groundrecover.groundlevel = 10
        air.gethit.airrecover.threshold = -1
        air.gethit.airrecover.yaccel = 0.35
        air.gethit.trip.groundlevel = 15
        down.bounce.offset = 0, 20
        down.bounce.yaccel = 0.4
        down.bounce.groundlevel = 12
        down.friction.threshold = 0.05
    }
}

