state 810 (type: S, movetype: A, physics: S, juggle: 0, velset: 0, 0, ctrl: 0, anim: 810, sprpriority: 2) {
    if AnimElem == 1 {
        TargetBind(pos: 30, 0)
    }
    if AnimElem == 2 {
        TargetBind(pos: 34, -14)
    }
    if AnimElem == 3 {
        TargetBind(pos: 26, -6)
    }
    if AnimElem == 3 {
        TargetLifeAdd(value: -125)
    }
    if AnimElem == 3 {
        TargetPowerAdd(value: -180)
    }
    if AnimElem == 3 {
        PlaySnd(value: S5, 3)
    }
    if AnimElem == 3 {
        Explod(
            anim: 6001,
            pos: 30, -34,
            postype: p1,
            removetime: -2,
            sprpriority: 3,
            scale: 0.8, 0.8,
        )
    }
    if AnimElem == 3 {
        EnvShake(time: 8, ampl: -4)
    }
    if AnimTime == 0 {
        TargetState(value: 821)
    }
    if AnimTime == 0 {
        ChangeState(value: 0, ctrl: 1)
    }
}

state 820 (type: A, movetype: H, physics: N, velset: 0, 0) {
