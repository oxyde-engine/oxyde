state 1400 (type: S, movetype: I, physics: S, velset: 0, 0, ctrl: 0, anim: 1400) {
    if AnimElem == 2 {
        VelSet(x: ifelse(command == "hold_z", 6.6, ifelse(command == "hold_y", 5.4, 4.2)), y: -8.4)
    }
    if AnimElem == 2 {
        StateTypeSet(statetype: A, physics: A)
    }
    if AnimElem == 1 {
        NotHitBy(value: , NT, ST, HT, time: 22)
    }
    if (command == "a" || command == "b" || command == "c") && statetype == A {
        ChangeState(value: 1200)
    }
    if Vel Y > 0 && Pos Y >= 0 {
        ChangeState(value: 52, ctrl: 0)
    }
}

