; ===========================================================================
;  ARROYO  -  Oxyde original cast
;  Escrima rushdown.  Fast, plus-on-block sticks, a rekka, a real anti-air,
;  and the rust that everything in Oxyde is made of.
;
;  Written against Elecbyte's own documentation (docs/sctrls.html, cns.html)
;  and data/common1.cns, which supplies states 0-5900.
; ===========================================================================

[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
; The art is drawn at roughly five hundred pixels tall. At 320x240 a fighter
; stands about ninety units high, so the scale is that ratio - not the 0.72
; the bundle shipped with, which drew him a screen and a half tall and left
; his opponent standing between his ankles.
xscale = 0.187
yscale = 0.187
ground.back = 14
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -86
mid.pos = -5, -45
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.6
walk.back = -2.4
run.fwd  = 6.0, 0
run.back = -4.6,-3.8
jump.neu = 0,-8.6
jump.back = -2.6
jump.fwd = 2.8
runjump.back = -2.6,-8.2
runjump.fwd = 4.2,-8.2
airjump.neu = 0,-8.2
airjump.back = -2.6
airjump.fwd = 2.8
air.gethit.groundrecover = -0.15,-3.5
air.gethit.airrecover.mul = 0.5
air.gethit.airrecover.add = 0,-3.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5

[Movement]
airjump.num = 1
airjump.height = 35
yaccel = 0.44
stand.friction = 0.85
crouch.friction = 0.82
stand.friction.threshold = 2
crouch.friction.threshold = 0.05
air.friction.threshold = 0.5
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = 0.35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = 0.4
down.bounce.groundlevel = 12
down.friction.threshold = 0.05

[Quotes]
victory1 = "The river cuts the iron."
victory2 = "Sinawali never sleeps."
victory3 = "Oxyde remembers every strike."
victory4 = "Rust is only patience."

; ---------------------------------------------------------------------------
; INTRO AND WIN
; common1.cns supplies 190 and 191 but nothing for the win pose, so the
; engine has no 180 to send him to unless the character writes one.
; ---------------------------------------------------------------------------
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0
[State 190, Go]
type = ChangeState
trigger1 = Time = 0
value = 191

[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0
[State 191, Dust]
type = Explod
trigger1 = AnimElem = 2
anim = 6000
pos = 20, -30
postype = p1
removetime = -2
sprpriority = 2
scale = 0.5, 0.5
[State 191, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 180]
