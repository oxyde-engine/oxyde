; ===========================================================================
; THROW
; The shape kfm's own commentary describes: a low-priority Miss-class HitDef
; that only catches players who are not already in a hit state, a p1stateno
; for the thrower and a p2stateno that brings the victim into this file.
; ===========================================================================
[Statedef 800]
type = S
movetype = A
physics = S
juggle = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2
[State 800, Grab]
type = HitDef
trigger1 = Time = 0
attr = S, NT
hitflag = M-
guardflag =
priority = 1, Miss
damage = 0, 0
pausetime = 0, 0
sparkno = -1
hitsound = -1
p1facing = 1
p2facing = 1
p1stateno = 810
p2stateno = 820
guard.dist = 0
fall = 1
[State 800, Miss]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 810]
type = S
movetype = A
physics = S
juggle = 0
velset = 0,0
ctrl = 0
anim = 810
sprpriority = 2
[State 810, Hold]
type = TargetBind
trigger1 = AnimElem = 1
pos = 30, 0
[State 810, Hold 2]
type = TargetBind
trigger1 = AnimElem = 2
pos = 34, -14
[State 810, Hold 3]
type = TargetBind
trigger1 = AnimElem = 3
pos = 26, -6
[State 810, Hurt]
type = TargetLifeAdd
trigger1 = AnimElem = 3
value = -125
[State 810, Erode]
type = TargetPowerAdd
trigger1 = AnimElem = 3
value = -180
[State 810, Snd]
type = PlaySnd
trigger1 = AnimElem = 3
value = S5, 3
[State 810, Flakes]
type = Explod
trigger1 = AnimElem = 3
anim = 6001
pos = 30, -34
postype = p1
removetime = -2
sprpriority = 3
scale = 0.8, 0.8
[State 810, Shake]
type = EnvShake
trigger1 = AnimElem = 3
time = 8
ampl = -4
[State 810, Throw]
type = TargetState
trigger1 = AnimTime = 0
value = 821
[State 810, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

; The victim's half of the throw. Both of these are read out of Arroyo's file
; while the opponent is inside it, whoever the opponent is.
[Statedef 820]
type = A
movetype = H
physics = N
velset = 0,0
[State 820, Anim]
type = ChangeAnim2
trigger1 = Time = 0
value = 820
; The escape hatch every MUGEN throw carries: if the hold is ever lost, the
; victim falls out of the throw instead of being stuck in it.
[State 820, Loose]
type = SelfState
trigger1 = !GetHitVar(isbound)
value = 5050

[Statedef 821]
type = A
movetype = H
physics = N
velset = -5.5,-6.5
[State 821, Fall]
type = HitFallSet
trigger1 = Time = 0
value = 1
[State 821, Vel]
type = HitVelSet
trigger1 = Time = 0
x = 0
y = 0
[State 821, Go]
type = SelfState
trigger1 = Time = 1
value = 5050

