state 0 (type: S, physics: S, sprpriority: 0) {
    if ((Anim != 0 && Anim != 5) || (Anim == 5 && AnimTime == 0)) {
        ChangeAnim(value: 0)
    }
    if Time == 0 {
        VelSet(y: 0)
    }
    if (abs(vel x) < 2 || Time == 4) {
        VelSet(x: 0)
    }
    if !alive {
        ChangeState(value: 5050)
    }
}

state 10 (type: C, physics: C, anim: 10) {
    if Time == 0 {
        VelMul(x: .75)
    }
    if AnimTime == 0 {
        ChangeState(value: 11)
    }
}

state 11 (type: C, physics: C, anim: 11, sprpriority: 0) {
    if (Anim == 6 && AnimTime == 0) {
        ChangeAnim(value: 11)
    }
}

state 12 (type: S, physics: S, anim: 12) {
    if AnimTime == 0 {
        ChangeState(value: 0)
    }
}

state 20 (type: S, physics: S, sprpriority: 0) {
    if command == "holdfwd" {
        VelSet(x: const(velocity.walk.fwd.x))
    }
    if command == "holdback" {
        VelSet(x: const(velocity.walk.back.x))
    }
    if vel x > 0 && ((Anim != 20 && Anim != 5) || (Anim == 5 && AnimTime == 0)) {
        ChangeAnim(value: 20)
    }
    if vel x < 0 && ((Anim != 21 && Anim != 5) || (Anim == 5 && AnimTime == 0)) {
        ChangeAnim(value: 21)
    }
}

state 40 (type: S, physics: S, anim: 40, ctrl: 0, sprpriority: 1) {
    if Time == 0 {
        VarSet(sysvar: 1, value: 0)
    }
    if command == "holdfwd" {
        VarSet(sysvar: 1, value: 1)
    }
    if command == "holdback" {
        VarSet(sysvar: 1, value: -1)
    }
    if AnimTime == 0 {
        VelSet(x: ifelse(sysvar(1) == 0, const(velocity.jump.neu.x), ifelse(sysvar(1) == 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x))), y: const(velocity.jump.y))
    }
    if AnimTime == 0 && prevstateno == 100 && sysvar(1) == 1 {
        VelSet(x: const(velocity.runjump.fwd.x))
    }
    if AnimTime == 0 {
        ChangeState(value: 50, ctrl: 1)
    }
}

state 45 (type: A, physics: N, ctrl: 0, velset: 0, 0) {
    if SelfAnimExist(44) {
        ChangeAnim(value: 44)
    }
    if !SelfAnimExist(44) {
        ChangeAnim(value: 41)
    }
    if Time == 0 {
        VarSet(sysvar: 1, value: 0)
    }
    if command == "holdfwd" {
        VarSet(sysvar: 1, value: 1)
    }
    if command == "holdback" {
        VarSet(sysvar: 1, value: -1)
    }
    if Time == 2 {
        VelSet(x: ifelse(sysvar(1) == 0, const(velocity.airjump.neu.x), ifelse(sysvar(1) == 1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x))), y: const(velocity.airjump.y))
    }
    if Time == 2 {
        ChangeState(value: 50, ctrl: 1)
    }
}

state 50 (type: A, physics: A) {
    if Time == 0 {
        VarSet(sysvar: 1, value: 0)
    }
    if Time == 0 {
        ChangeAnim(value: ifelse((vel x) == 0, 41, ifelse((vel x) > 0, 42, 43)))
    }
    if Vel y > -2 && SelfAnimExist(anim + 3) {
        @persistent(0) 
        ChangeAnim(value: Anim + 3)
    }
}

state 51 (type: A, physics: A) {
