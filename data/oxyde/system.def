[Begin Action 190]
190, 0, 0,0, -1

;------------------------------------------------------- the closing screens

[Demo Mode]
enabled           = 1
select.enabled    = 0
vsscreen.enabled  = 1
title.waittime    = 900
fight.endtime     = 1500
fight.playbgm     = 1
fight.bars.display = 1
intro.waitcycles  = 3
debuginfo         = 0

[Continue Screen]
enabled = 1

[Game Over Screen]
enabled    = 0
storyboard =

[Win Screen]
enabled             = 1
wintext.text        = "%s WINS"
wintext.font        = 3, 2, 0
wintext.offset      = 320, 120
wintext.displaytime = -1
wintext.layerno     = 2
fadein.time         = 24
pose.time           = 300
fadeout.time        = 48

[Default Ending]
enabled    = 0
storyboard =

[End Credits]
enabled    = 0
storyboard =

[Survival Results Screen]
enabled              = 1
winstext.text        = "ROUNDS SURVIVED: %i"
winstext.font        = 3, 2, 0
winstext.offset      = 320, 130
winstext.displaytime = -1
winstext.layerno     = 2
fadein.time          = 24
show.time            = 300
fadeout.time         = 48
roundstowin          = 5
