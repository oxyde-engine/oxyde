;------------------------------------------------------------------------------
;  O X Y D E
;
;  The engine's own look, as a screenpack: a black circuit board with etched
;  traces, the OXYDE wordmark with its hexagonal O in ember, a hairline rule,
;  and Oxyde orange spent on exactly one thing -- the row you are about to
;  choose.
;
;  Authored at 640x480 -- see localcoord below -- rather than the 320x240 every
;  WinMugen pack uses. At twice the resolution a 20x10 grid of 28-pixel cells
;  fits under the portraits, so this archive's 1,040 fighters are six pages
;  instead of forty, and the fonts have enough pixels to stay legible on a
;  1080p panel.
;
;  Every sprite and every font in this pack is generated by
;  data/oxyde/build_screenpack.py -- edit that and re-run it.
;
;  Paths below are written relative to data/, which is how a pack installed in
;  a subfolder of data/ has to write them.
;------------------------------------------------------------------------------

[Info]
name       = "Oxyde"
author     = "the Oxyde project"
localcoord = 640, 480

[Files]
spr              = oxyde/system.sff
snd              = system.snd
logo.storyboard  =
intro.storyboard =
select           = select.def
fight            = oxyde/fight.def
font1            = oxyde/font/oxyde-s.fnt      ; 11px  - footers, counters
font2            = oxyde/font/oxyde-m.fnt      ; 15px  - names, stage, menu
font3            = oxyde/font/oxyde-l.fnt      ; 19px  - headings

[Music]
title.bgm       = sound/alpha-mugen.mp3
title.bgm.loop  = 1
select.bgm      = sound/alpha-thisisn'tnotjupiter.mp3
select.bgm.loop = 1
vs.bgm          = sound/alpha-outlate.mp3
vs.bgm.loop     = 0

;------------------------------------------------------------------- title

[Title Info]
fadein.time  = 12
fadeout.time = 12

; Oxyde draws this pack's title screen itself: the wordmark, every mode, the
; highlighted one in Oxyde orange and the line explaining it, over an animated
; backdrop drawn at the window's own resolution. An Oxyde key; WinMUGEN
; ignores it and lays the menu out from the lines below, over [TitleBG].
title.style = oxyde

; Eighteen modes, all of them on screen at once. Packs from 2002 show five
; because the engine they were drawn for had eleven; scrolling a menu that
; fits is a needless step.
; Up six units and a point tighter than it was, to leave the bottom of the
; screen for the engine's one-line description of the highlighted mode. The
; list still starts clear of the wordmark's rule.
menu.pos                 = 320, 170
menu.item.font           = 2, 0, 0
menu.item.active.font    = 2, 2, 0      ; ember: the highlighted row is orange text
menu.item.spacing        = 0, 15
menu.window.margins.y    = 4, 4
menu.window.visibleitems = 18

menu.itemname.arcade       = "ARCADE"
menu.itemname.survival     = "SURVIVAL"
menu.itemname.training     = "TRAINING"
menu.itemname.versus       = "VERSUS"
menu.itemname.teamarcade   = "TEAM ARCADE"
menu.itemname.teamversus   = "TEAM VERSUS"
menu.itemname.teamcoop     = "TEAM CO-OP"
menu.itemname.survivalcoop = "SURVIVAL CO-OP"
menu.itemname.watch        = "WATCH"
menu.itemname.options      = "OPTIONS"
menu.itemname.exit         = "EXIT"

; No box: the row the player is about to choose is the only orange text on
; the screen, and that is the whole highlight. The box is kept configured for
; anyone who turns it back on.
menu.boxcursor.visible = 0
menu.boxcursor.coords  = -150, -16, 150, 0
menu.boxcursor.col     = 24, 96, 126
menu.boxcursor.alpha   = 24, 96

cursor.move.snd = 100, 0
cursor.done.snd = 100, 1
cancel.snd      = 100, 2

[TitleBGdef]
bgclearcolor = 5, 7, 12
; Oxyde draws its circuit board here at the window's own resolution
; (bloom, seed -- build_screenpack.py's circuit_board). WinMUGEN ignores
; the key and clears to the colour above.
board        = 1.0, 12655845

[TitleBG 0]
type     = normal
spriteno = 100, 0
mask     = 1
start    = 0, 0
velocity = 0, 0

[TitleBG 1]
type     = normal
spriteno = 101, 0
start    = 0, 0
tile     = 1, 1
trans    = add
velocity = -.15, -.09

;------------------------------------------------------------------ select

[Select Info]
fadein.time  = 10
fadeout.time = 10

; 20 x 10 = 200 cells a page. 1,040 characters is six pages, and the engine
; pages rather than truncating, so nothing on the roster is unreachable.
rows               = 10
columns            = 20
pos                = 21, 156
cell.size          = 28, 28
cell.spacing       = 2, 2
wrapping           = 1
showemptyboxes     = 0
moveoveremptyboxes = 0

cell.bg.spr             = 150, 0
cell.random.anim        = 151
cell.random.switchtime  = 4

portrait.offset = 1, 1
portrait.scale  = 1.04, 1.04

p1.cursor.startcell   = 0, 0
p1.cursor.active.anim = 160
p1.cursor.done.spr    = 161, 0
p1.cursor.move.snd    = 101, 0
p1.cursor.done.snd    = 101, 1
p1.random.move.snd    = 101, 0

p2.cursor.startcell   = 0, 19
p2.cursor.active.anim = 170
p2.cursor.done.spr    = 171, 0
p2.cursor.blink       = 1
p2.cursor.move.snd    = 102, 0
p2.cursor.done.snd    = 102, 1
p2.random.move.snd    = 102, 0

random.move.snd.cancel = 1
stage.move.snd         = 100, 0
stage.done.snd         = 100, 3
cancel.snd             = 100, 2

title.offset = 320, 4
title.font   = 3, 1, 0

p1.face.offset = 18, 32
p1.face.scale  = .7, .7
p1.face.facing = 1
p1.name.offset = 18, 133
p1.name.font   = 2, 4, 1

p2.face.offset = 622, 32
p2.face.scale  = .7, .7
p2.face.facing = -1
p2.name.offset = 622, 133
p2.name.font   = 2, 3, -1

; The strip between the portraits and the grid: what has been typed, what the
; mode wants, and which page of the roster is on screen. A grid that pages has
; to say so, and a search box that cannot be seen cannot be trusted.
search.offset = 20, 10
search.font   = 1, 1, 1
page.offset   = 620, 10
page.font     = 1, 5, -1
note.offset   = 320, 136
note.font     = 1, 2, 0

stage.pos          = 320, 459
stage.active.font  = 2, 2, 0
stage.active2.font = 2, 1, 0
stage.done.font    = 2, 0, 0

teammenu.move.wrapping = 1

p1.teammenu.pos                    = 40, 200
p1.teammenu.selftitle.font         = 2, 1, 1
p1.teammenu.selftitle.text         = "SELECT TEAM MODE"
p1.teammenu.enemytitle.font        = 2, 1, 1
p1.teammenu.enemytitle.text        = "OPPONENT TEAM MODE"
p1.teammenu.move.snd               = 100, 0
p1.teammenu.value.snd              = 100, 0
p1.teammenu.done.snd               = 100, 1
p1.teammenu.item.offset            = 0, 30
p1.teammenu.item.spacing           = 0, 24
p1.teammenu.item.font              = 2, 5, 1
p1.teammenu.item.active.font       = 2, 1, 1
p1.teammenu.item.active2.font      = 2, 0, 1
p1.teammenu.item.cursor.offset     = -18, -8
p1.teammenu.item.cursor.anim       = 180
p1.teammenu.value.icon.offset      = 150, -9
p1.teammenu.value.icon.spr         = 181, 0
p1.teammenu.value.empty.icon.offset = 150, -9
p1.teammenu.value.empty.icon.spr   = 182, 0
p1.teammenu.value.spacing          = 16, 0

p2.teammenu.pos                    = 600, 200
p2.teammenu.selftitle.font         = 2, 1, -1
p2.teammenu.selftitle.text         = "SELECT TEAM MODE"
p2.teammenu.enemytitle.font        = 2, 1, -1
p2.teammenu.enemytitle.text        = "OPPONENT TEAM MODE"
p2.teammenu.move.snd               = 100, 0
p2.teammenu.value.snd              = 100, 0
p2.teammenu.done.snd               = 100, 1
p2.teammenu.item.offset            = 0, 30
p2.teammenu.item.spacing           = 0, 24
p2.teammenu.item.font              = 2, 5, -1
p2.teammenu.item.active.font       = 2, 3, -1
p2.teammenu.item.active2.font      = 2, 0, -1
p2.teammenu.item.cursor.offset     = 18, -8
p2.teammenu.item.cursor.anim       = 190
p2.teammenu.value.icon.offset      = -150, -9
p2.teammenu.value.icon.spr         = 191, 0
p2.teammenu.value.empty.icon.offset = -150, -9
p2.teammenu.value.empty.icon.spr   = 192, 0
p2.teammenu.value.spacing          = -16, 0

[SelectBGdef]
bgclearcolor = 5, 7, 12

[SelectBG 0]
type     = normal
spriteno = 100, 1
start    = 0, 0
velocity = 0, 0

[SelectBG 1]
type     = normal
spriteno = 101, 0
start    = 0, 0
tile     = 1, 1
trans    = add
velocity = -.12, .07

[SelectBG 2]
type     = normal
spriteno = 111, 0
start    = 0, 30
velocity = 0, 0

;------------------------------------------------------------------ versus

[VS Screen]
time         = 240
fadein.time  = 14
fadeout.time = 14

p1.pos       = 41, 83
p1.facing    = 1
p1.scale     = 1.6, 1.6
; Fit each portrait to a shared box so an HD portrait and a classic low-res
; one render at matched size. Remove p?.window to use the fixed p?.scale.
p1.window    = 240, 250
p1.name.pos  = 137, 340
p1.name.font = 3, 4, 0

p2.pos       = 599, 83
p2.facing    = -1
p2.scale     = 1.6, 1.6
p2.window    = 240, 250
p2.name.pos  = 503, 340
p2.name.font = 3, 3, 0

[VersusBGdef]
bgclearcolor = 5, 7, 12

[VersusBG 0]
type     = normal
spriteno = 100, 2
start    = 0, 0
velocity = 0, 0

[VersusBG 1]
type     = normal
spriteno = 101, 0
start    = 0, 0
tile     = 1, 1
trans    = add
velocity = .25, -.12

;----------------------------------------------------------------- options

[Option Info]
cursor.move.snd = 100, 0
cursor.done.snd = 100, 1
cancel.snd      = 100, 2

[OptionBGdef]
bgclearcolor = 5, 7, 12
; Oxyde draws its circuit board here at the window's own resolution
; (bloom, seed -- build_screenpack.py's circuit_board). WinMUGEN ignores
; the key and clears to the colour above.
board        = 0.5, 462981

[OptionBG 0]
type     = normal
spriteno = 100, 3
mask     = 1
start    = 0, 0
velocity = 0, 0

[OptionBG 1]
type     = normal
spriteno = 101, 0
start    = 0, 0
tile     = 1, 1
trans    = add
velocity = .1, -.1

